# Salin ke backend/.env. Semua path relatif terhadap folder backend/.
PORT=3001

# Data runtime (di luar git)
DATA_DIR=../data
UPLOAD_DIR=../data/uploads
CACHE_DIR=../data/cache
PARSER_OUTPUT_DIR=../data/processed/parser_output
MAX_UPLOAD_MB=50

# Model klaster tier — salinan lokal backend, diisi oleh ai-model/training/export_model.py
TIER_MODEL_PATH=./models/tier_kmeans.json

# LLM lokal (narasi). Tidak ada LLM API.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=60000
PROMPT_VERSION=narrative_v6
# REV-06: batas token keluaran narasi (lebih kecil = lebih cepat)
OLLAMA_NUM_PREDICT=400

# Tahap 5: harga online (yahoo | off). off = hanya harga manual dari UI.
PRICE_PROVIDER=yahoo
# false = selalu pakai ringkasan templat tanpa memanggil Ollama
USE_OLLAMA=true
