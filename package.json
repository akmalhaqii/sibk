{
  "name": "telusurfin",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "export:parser": "npm --prefix backend run export:parser",
    "build:features": "npm --prefix backend run build:features"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
